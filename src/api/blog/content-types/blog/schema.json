{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "Entradas del blog de Agitalo Suave"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "receta",
        "bitacora",
        "tecnica",
        "tip"
      ],
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "updated": {
      "type": "date"
    },
    "excerpt": {
      "type": "text"
    },
    "tags": {
      "type": "json"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "headerImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ingredients": {
      "type": "json"
    },
    "steps": {
      "type": "json"
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "richtext",
      "required": true
    }
  }
}
